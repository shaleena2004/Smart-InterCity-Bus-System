{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/bus-list.js",
    "app/supplier-list.js",
    "app/modal.js",
    "app/performance.js",
    "app/_layout.js",
    "app/(tabs)/index.js",
    "app/(tabs)/_layout.js",
    "app/(tabs)/explore.js"
  ]
}