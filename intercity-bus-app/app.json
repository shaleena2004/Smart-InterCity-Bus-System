{
  "expo": {
    "name": "intercity-bus-app",
    "slug": "intercity-bus-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "intercitybusapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#E6F4FE",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
